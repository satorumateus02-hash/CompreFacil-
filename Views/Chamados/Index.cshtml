@model List<HelpDeskMvc.Models.Chamado>

@{
    ViewData["Title"] = "Solicitar Atendimento Domiciliar";
}

<div class="container mt-4">
    <h1>Solicitar Atendimento Domiciliar</h1>
    <hr />

    <div class="mb-3">
        <a asp-controller="Chamados" asp-action="Criar" class="btn btn-success">
            Solicitar Atendimento Domiciliar
        </a>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Telefone</th>
                <th>Endereço</th>
                <th>Complemento</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var chamado in Model)
            {
                <tr>
                    <td>@(string.IsNullOrEmpty(chamado.ClienteNome) ? chamado.Titulo : chamado.ClienteNome)</td>
                    <td>@chamado.Telefone</td>
                    <td>@chamado.Endereco</td>
                    <td>@chamado.Complemento</td>
                    <td>
                        <a asp-controller="Chamados"
                           asp-action="Detalhes"
                           asp-route-id="@chamado.Id"
                           class="btn btn-primary btn-sm">
                            Ver Detalhes
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>